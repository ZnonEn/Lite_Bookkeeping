<?xml version="1.0" encoding="utf-8"?><!--
  Android 12+ 的数据提取规则。
  本应用定位「数据只留本机」，云备份与换机传输均排除账本数据；
  用户要迁移请用设置页的「导出 Excel 备份」显式操作。
  规则与 backup_rules.xml（Android 11 及以下）保持一致。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bookkeeping.db" />
        <exclude domain="database" path="bookkeeping.db-shm" />
        <exclude domain="database" path="bookkeeping.db-wal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bookkeeping.db" />
        <exclude domain="database" path="bookkeeping.db-shm" />
        <exclude domain="database" path="bookkeeping.db-wal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
